    <script>
        const gradeInput = document.getElementById("Grade");
        const equivalentBox = document.getElementById("equivalentBox");

        gradeInput.addEventListener("input", function() {
            let grade = parseFloat(gradeInput.value);
            let equivalent = "—";
            let remark = "";

            if (!isNaN(grade)) {
                if (grade >= 97 && grade <= 100) {
                    equivalent = "1.00";
                    remark = "Perfect";
                } else if (grade >= 94 && grade <= 96.99) {
                    equivalent = "1.25";
                    remark = "Excellent";
                } else if (grade >= 91 && grade <= 93.99) {
                    equivalent = "1.50";
                    remark = "Very Good";
                } else if (grade >= 88 && grade <= 90.99) {
                    equivalent = "1.75";
                    remark = "Very Good";
                } else if (grade >= 85 && grade <= 87.99) {
                    equivalent = "2.00";
                    remark = "Good";
                } else if (grade >= 84 && grade <= 86.00) {
                    equivalent = "2.25";
                    remark = "Good";
                } else if (grade >= 82 && grade <= 83.99) {
                    equivalent = "2.50";
                    remark = "Fair";
                } else if (grade >= 79 && grade <= 81.99) {
                    equivalent = "2.75";
                    remark = "Fair";
                } else if (grade >= 75 && grade <= 78.99) {
                    equivalent = "3.00";
                    remark = "Pass";
                } else {
                    equivalent = "5.00";
                    remark = "You fail :(";
                }
            }

            equivalentBox.textContent = "Equivalent: " + equivalent + " | " + remark;
        });
    </script>
