        if (isset($_POST['submit'])) {
            $conn = new mysqli("localhost", "root", "", "csdb_geone");
            if ($conn->connect_error) { die("Die! " . $conn->connect_error); }

            $name = htmlspecialchars($_POST['name']);
            $lastn = htmlspecialchars($_POST['lastn']);
            $Student_Id = htmlspecialchars($_POST['Student_Id']);
            $Grade = floatval($_POST['Grade']); // numeric grade

            // INSERT only grade
            $sql = "INSERT INTO cstbl_geone (Firstname, Lastname, Student_Id, Grade) 
                    VALUES ('$name', '$lastn', '$Student_Id', '$Grade')";
            if ($conn->query($sql) === TRUE) {
                echo "<p style='color:green;'>Record inserted successfully!</p>";
            } else {
                echo "<p style='color:red;'>Error: " . $conn->error . "</p>";
            }

            // DISPLAY records
            $sql1 = "SELECT id, Firstname, Lastname, Student_Id, Grade, Registration_Date FROM cstbl_geone";
            $result = $conn->query($sql1);

            if ($result && $result->num_rows > 0) {
                echo "<table>";
                echo "<tr><th>ID</th><th>Firstname</th><th>Lastname</th><th>Student ID</th><th>Grade</th><th>Registration Date</th></tr>";
                while ($row = $result->fetch_assoc()) {
                    echo "<tr>";
                    echo "<td>" . $row["id"] . "</td>";
                    echo "<td>" . $row["Firstname"] . "</td>";
                    echo "<td>" . $row["Lastname"] . "</td>";
                    echo "<td>" . $row["Student_Id"] . "</td>";
                    echo "<td>" . $row["Grade"] . "</td>";
                    echo "<td>" . $row["Registration_Date"] . "</td>";
                    echo "</tr>";
                }
                echo "</table>";
            } else {
                echo "<p style='color:red;'>0 results or query error: " . $conn->error . "</p>";
            }

            $conn->close();
        }
